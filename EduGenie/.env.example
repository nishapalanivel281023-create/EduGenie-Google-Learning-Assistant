# Required for Gemini-powered Q&A, quiz, summary and learning paths.
GEMINI_API_KEY=your_gemini_api_key_here

# You can change this to another Gemini text model available to your API key.
GEMINI_MODEL=gemini-2.5-flash

# Optional local explanation model.
# false = Gemini handles explanations too (recommended for the first run).
# true  = tries LaMini-Flan-T5 locally and falls back to Gemini if it fails.
USE_LOCAL_EXPLAINER=false
LOCAL_EXPLAINER_MODEL=MBZUAI/LaMini-Flan-T5-783M
